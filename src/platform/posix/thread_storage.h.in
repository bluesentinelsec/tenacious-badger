/** @file thread_storage.h
 * @brief Build-selected sizes of the POSIX synchronization objects on Linux
 * and macOS.
 */
#ifndef TB_THREAD_STORAGE_H
#define TB_THREAD_STORAGE_H

/** @brief Pointer-sized words in a tb_mutex: one that records whether the
 * system's mutex has been made, the mutex, 64 bytes at its largest, and the
 * thread that holds it, which builds with assertions record. */
#define TB_MUTEX_STORAGE_WORDS 10

/** @brief Pointer-sized words in a tb_condition: one that records whether the
 * system's condition variable has been made, and the variable, 48 bytes. */
#define TB_CONDITION_STORAGE_WORDS 7

#endif
