{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C17: build debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "C17: test",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "debug"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        {
          "owner": "tb_test",
          "source": "tb_test",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^(.+)\\((\\d+)\\): (error): (.*)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        },
        {
          "owner": "tb_test",
          "source": "tb_test",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^(.+):(\\d+): (error): (.*)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        }
      ]
    }
  ]
}
