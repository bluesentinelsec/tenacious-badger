# Writes a C source that holds files as arrays of bytes, for tests whose data
# cannot be written in C: a published corpus, or archives that other tools
# made. The tests stay one executable that needs no files beside it.
#
# Run as a script, cmake -P EmbedTestData.cmake, with:
#   OUTPUT     the C source to write.
#   NAME       the array of tb_test_file it defines, and NAME_count, its length.
#   DIRECTORY  the directory of the files.
#   PATTERN    which files of DIRECTORY to embed, as a glob such as "*.json".
#
# Files are in the order of their names. Each array of bytes ends with a zero
# that its length does not count, so text can be read as a C string, and an
# empty file still has an array.

foreach(variable OUTPUT NAME DIRECTORY PATTERN)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "EmbedTestData.cmake needs -D${variable}=...")
    endif()
endforeach()

file(GLOB files RELATIVE "${DIRECTORY}" "${DIRECTORY}/${PATTERN}")
list(SORT files)

# Sixteen bytes to a line.
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_pattern)

set(arrays "")
set(entries "")
set(index 0)
foreach(file IN LISTS files)
    if(file MATCHES "[\"\\\\]")
        message(FATAL_ERROR "EmbedTestData.cmake: ${file}: a name cannot hold \" or \\")
    endif()
    file(SIZE "${DIRECTORY}/${file}" length)
    file(READ "${DIRECTORY}/${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${line_pattern})" "\\1\n    " bytes "${bytes}")
    string(APPEND arrays "static const unsigned char file_${index}[] = {\n    ${bytes}0x00};\n")
    string(APPEND entries "    {\"${file}\", file_${index}, ${length}},\n")
    math(EXPR index "${index} + 1")
endforeach()

if(index EQUAL 0)
    message(FATAL_ERROR "EmbedTestData.cmake: no file of ${DIRECTORY} matches ${PATTERN}")
endif()

file(WRITE "${OUTPUT}.tmp"
    "/* Generated by cmake/EmbedTestData.cmake from ${DIRECTORY}. Do not edit. */\n"
    "#include \"test_data.h\"\n\n"
    "${arrays}\n"
    "extern const tb_test_file ${NAME}[];\n"
    "extern const size_t ${NAME}_count;\n\n"
    "const tb_test_file ${NAME}[] = {\n${entries}};\n"
    "const size_t ${NAME}_count = ${index};\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
