# Builds the engine's own shader files, every .hlsl and .hlsli under
# shaders/, into the engine library, so that the engine compiles and finds
# its shaders with no shader directory beside it. shaders/Engine/Private/Sky.hlsl
# is the file /Engine/Private/Sky.hlsl, which tb_shader_engine_loader() reads.
#
# The C source is written when CMake configures, and again whenever a shader
# file is added, removed or changed, which makes CMake configure again. It is
# written beside its place first, then copied over it only if it changed, so
# the build sees no change that is not there.

set(TB_SHADER_DIRECTORY "${PROJECT_SOURCE_DIR}/shaders")

# Writes the C source, and names it in the variable `output`.
function(tb_embed_engine_shaders output)
    file(GLOB_RECURSE files RELATIVE "${TB_SHADER_DIRECTORY}" CONFIGURE_DEPENDS
        "${TB_SHADER_DIRECTORY}/*.hlsl" "${TB_SHADER_DIRECTORY}/*.hlsli")
    list(SORT files)
    set(source "${PROJECT_BINARY_DIR}/generated/shaders/engine_shaders.c")
    set(arrays "")
    set(entries "")
    set(index 0)
    foreach(file IN LISTS files)
        if(file MATCHES "[\"\\\\ ]")
            message(FATAL_ERROR "EmbedShaders.cmake: ${file}: a shader's path holds no \", \\ or space")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${TB_SHADER_DIRECTORY}/${file}")
        file(SIZE "${TB_SHADER_DIRECTORY}/${file}" length)
        file(READ "${TB_SHADER_DIRECTORY}/${file}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_pattern)
        string(REGEX REPLACE "(${line_pattern})" "\\1\n    " bytes "${bytes}")
        string(APPEND arrays "static const char file_${index}[] = {\n    ${bytes}0x00};\n")
        string(APPEND entries "    {\"/${file}\", file_${index}, ${length}},\n")
        math(EXPR index "${index} + 1")
    endforeach()
    if(index EQUAL 0)
        string(APPEND entries "    {NULL, NULL, 0},\n")
    endif()
    string(RANDOM LENGTH 12 suffix)
    set(temporary "${source}.${suffix}.tmp")
    file(WRITE "${temporary}"
        "/* Generated by cmake/EmbedShaders.cmake from shaders/. Do not edit. */\n"
        "#include \"badger/shader.h\"\n\n"
        "#include <stddef.h>\n\n"
        "extern const tb_shader_file tb_shader_engine_files[];\n"
        "extern const size_t tb_shader_engine_file_count;\n\n"
        "${arrays}\n"
        "const tb_shader_file tb_shader_engine_files[] = {\n${entries}};\n\n"
        "const size_t tb_shader_engine_file_count = ${index};\n")
    file(COPY_FILE "${temporary}" "${source}" ONLY_IF_DIFFERENT)
    file(REMOVE "${temporary}")
    set(${output} "${source}" PARENT_SCOPE)
endfunction()
