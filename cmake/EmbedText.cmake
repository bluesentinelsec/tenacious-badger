# Writes a C source that holds a text file as a NUL-terminated array of
# chars, for a program that carries a file in its executable, such as a game's
# default settings.
#
# Run as a script, cmake -P EmbedText.cmake, with:
#   INPUT   the file to embed.
#   OUTPUT  the C source to write.
#   NAME    the array it defines, `const char NAME[]`, and `NAME_length`, the
#           file's length, which does not count the NUL.

foreach(variable INPUT OUTPUT NAME)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "EmbedText.cmake needs -D${variable}=...")
    endif()
endforeach()

file(SIZE "${INPUT}" length)
file(READ "${INPUT}" hex HEX)
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_pattern)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(${line_pattern})" "\\1\n    " bytes "${bytes}")

# Written beside the output under a name of its own, then copied over it only
# if it changed, so the build does not see a change that is not there.
string(RANDOM LENGTH 12 suffix)
set(temporary "${OUTPUT}.${suffix}.tmp")
file(WRITE "${temporary}"
    "/* Generated by cmake/EmbedText.cmake from ${INPUT}. Do not edit. */\n"
    "#include <stddef.h>\n\n"
    "extern const char ${NAME}[];\n"
    "extern const size_t ${NAME}_length;\n\n"
    "const char ${NAME}[] = {\n    ${bytes}0x00};\n"
    "const size_t ${NAME}_length = ${length};\n")
file(COPY_FILE "${temporary}" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${temporary}")
