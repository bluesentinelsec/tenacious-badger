#[[
Build-time step of tb_add_test_executable. Reads the manifest named by
TB_TEST_MANIFEST, finds every TB_TEST(suite, name) in the listed sources, and
writes two files:

  TB_TEST_REGISTRY     C source that lists the cases and defines tb_test_main().
  TB_TEST_CTEST_CASES  CTest script with one test per case and its location.

A definition is recognized when `TB_TEST(` starts its line and both names are
identifiers on that line. Definitions hidden from the compiler (by `#if` or a
block comment) are still found here and then fail the link, which is loud by
design: a case must never vanish silently.
]]
cmake_minimum_required(VERSION 3.25)

if(NOT TB_TEST_MANIFEST)
    message(FATAL_ERROR "TbTestScan.cmake: set TB_TEST_MANIFEST to the scan manifest")
endif()
include("${TB_TEST_MANIFEST}")

set(identifier "[A-Za-z_][A-Za-z0-9_]*")
set(definition
    "(^|\n)[ \t]*TB_TEST[ \t]*\\([ \t]*(${identifier})[ \t]*,[ \t]*(${identifier})[ \t]*\\)")

set(case_symbols "")
set(case_keys "")
set(ctest_content "# Generated by TbTestScan.cmake for ${TB_TEST_TARGET}. Do not edit.\n")

foreach(source IN LISTS TB_TEST_SOURCES)
    file(READ "${source}" remaining)
    set(line 1)
    while(TRUE)
        string(REGEX MATCH "${definition}" matched "${remaining}")
        if(matched STREQUAL "")
            break()
        endif()
        set(suite "${CMAKE_MATCH_2}")
        set(name "${CMAKE_MATCH_3}")

        # Count the newlines up to the end of the match. The match itself spans
        # at most the newline before the definition, so this is its line.
        string(FIND "${remaining}" "${matched}" match_start)
        string(LENGTH "${matched}" match_length)
        math(EXPR match_end "${match_start} + ${match_length}")
        string(SUBSTRING "${remaining}" 0 ${match_end} consumed)
        string(REGEX REPLACE "[^\n]" "" newlines "${consumed}")
        string(LENGTH "${newlines}" newline_count)
        math(EXPR line "${line} + ${newline_count}")
        string(SUBSTRING "${remaining}" ${match_end} -1 remaining)

        set(key "${suite}.${name}")
        if(key IN_LIST case_keys)
            message(FATAL_ERROR
                "${source}:${line}: test case ${key} is already defined at "
                "${location_${suite}__${name}}; names must be unique in ${TB_TEST_TARGET}")
        endif()
        list(APPEND case_keys "${key}")
        set(location_${suite}__${name} "${source}:${line}")
        list(APPEND case_symbols "tb_test_case_${suite}__${name}")

        set(ctest_name "${TB_TEST_NAME_PREFIX}${key}${TB_TEST_NAME_SUFFIX}")
        string(APPEND ctest_content
            "add_test([==[${ctest_name}]==] \"\${TB_TEST_EXECUTABLE}\" [==[${key}]==])\n"
            "set_tests_properties([==[${ctest_name}]==] PROPERTIES\n"
            "    SKIP_RETURN_CODE 77\n"
            "    DEF_SOURCE_LINE [==[${source}:${line}]==])\n")
    endwhile()
endforeach()

if(NOT case_symbols)
    list(JOIN TB_TEST_SOURCES "\n  " listed_sources)
    message(FATAL_ERROR
        "No TB_TEST(suite, name) definition found for ${TB_TEST_TARGET} in:\n"
        "  ${listed_sources}\n"
        "Each definition must start its own line.")
endif()

# Built with string(APPEND): the text is full of semicolons, which a CMake list
# would treat as separators.
set(registry_content "/* Generated by TbTestScan.cmake for ${TB_TEST_TARGET}. Do not edit. */\n")
string(APPEND registry_content "#include \"tb_test.h\"\n\n")
foreach(symbol IN LISTS case_symbols)
    string(APPEND registry_content "extern const tb_test_case ${symbol};\n")
endforeach()
string(APPEND registry_content
    "\nstatic const tb_test_case *const tb_test_registered_cases[] = {\n")
foreach(symbol IN LISTS case_symbols)
    string(APPEND registry_content "    &${symbol},\n")
endforeach()
string(APPEND registry_content
    "};\n\n"
    "int tb_test_main(int argc, char **argv)\n"
    "{\n"
    "    const size_t case_count =\n"
    "        sizeof(tb_test_registered_cases) / sizeof(tb_test_registered_cases[0]);\n\n"
    "    return tb_test_run(argc, argv, tb_test_registered_cases, case_count);\n"
    "}\n")

file(WRITE "${TB_TEST_REGISTRY}" "${registry_content}")
file(WRITE "${TB_TEST_CTEST_CASES}" "${ctest_content}")
